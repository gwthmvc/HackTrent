# TigerData Cloud connection string. Keep the real value in backend/.env only.
# TLS is enforced by the application. Keep sslmode=require in the service URL.
TIGERDATA_DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/YOUR_DATABASE?sslmode=require
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
TICKETMASTER_API_KEY=YOUR_TICKETMASTER_API_KEY
# Optional Ticketmaster limits (defaults shown). Results are cached in memory.
EVENTS_CACHE_TTL_SECONDS=900
EVENTS_MAX_RESULTS=20
TICKETMASTER_MAX_REQUESTS_PER_MINUTE=20
TICKETMASTER_MAX_REQUESTS_PER_DAY=1000
EVENTS_MAX_SEARCHES_PER_USER_PER_MINUTE=10
TIGERDATA_SCHEMA=public
TIGERDATA_BUS_POSITIONS_TABLE=bus_positions

# Canonical API agency IDs mapped to their exact stored database values.
TIGERDATA_AGENCY_VALUES={"kingston":"kingston","durham":"durham"}
TRANSIT_STALE_AFTER_SECONDS=300
TRANSIT_MAX_VEHICLES=200
TRANSIT_LOOKBACK_HOURS=24

# Durham Region Transit GTFS static schedule cache
GTFS_DURHAM_FEED_URL=https://maps.durham.ca/OpenDataGTFS/GTFS_Durham_TXT.zip
GTFS_CACHE_DIR=./data/gtfs
GTFS_REQUEST_TIMEOUT_SECONDS=30
GTFS_MAX_ARCHIVE_BYTES=50000000
GTFS_MAX_UNCOMPRESSED_BYTES=300000000
GTFS_USER_AGENT=SmartMoveOntario/0.1 (HackTrent educational project)
GTFS_DEFAULT_STOP_RADIUS_METERS=800
GTFS_MAX_JOURNEYS=5

# Optional schema overrides. Leave blank to use verified column-name discovery.
TIGERDATA_AGENCY_COLUMN=
TIGERDATA_VEHICLE_ID_COLUMN=
TIGERDATA_ROUTE_COLUMN=
TIGERDATA_LATITUDE_COLUMN=
TIGERDATA_LONGITUDE_COLUMN=
TIGERDATA_OBSERVED_AT_COLUMN=

# Auth0 API settings. Create an Auth0 API audience for this backend.
AUTH_REQUIRED=true
AUTH0_DOMAIN=YOUR_AUTH0_TENANT.auth0.com
AUTH0_AUDIENCE=https://api.smartmove.example
AUTH0_REQUIRED_SCOPE=read:transit

# JSON array of exact browser origins. Wildcards are intentionally unsupported.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Public OpenStreetMap Overpass integration. Keep searches bounded and cached.
OVERPASS_BASE_URL=https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_SECONDS=18
OVERPASS_QUERY_TIMEOUT_SECONDS=12
OVERPASS_MAX_RESPONSE_BYTES=8000000
OVERPASS_USER_AGENT=SmartMoveOntario/0.1 (HackTrent educational project)
PLACES_CACHE_TTL_SECONDS=3600
PLACES_MAX_RESULTS=60
PLACES_MAX_SEARCHES_PER_USER_PER_MINUTE=10
OVERPASS_MAX_REQUESTS_PER_MINUTE=4
