VITE_AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
VITE_AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://api.smartmove.example
VITE_AUTH0_API_SCOPE=openid profile email read:transit

# Local FastAPI base URL. This value is public; database credentials remain in backend/.env.
VITE_SMARTMOVE_API_URL=http://localhost:8000

# Public URL for the Vultr Gemini chat service, or /api/chat when proxied.
VITE_CHAT_API_URL=/api/chat

# Browser-safe values only. Use the complete backend generation URL after a
# compatible endpoint has been implemented. Never add private API keys here.
VITE_SMARTMOVE_GENERATE_URL=
